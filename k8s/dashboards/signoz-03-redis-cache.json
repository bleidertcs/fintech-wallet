{
  "title": "FinTech Wallet - 03. Redis Cache & Idempotency Operations",
  "description": "Dashboard de Tasa de Aciertos (%) (Hit/Miss Rate), Memoria Usada, Comandos por Segundo e Idempotencia en Redis",
  "tags": ["redis", "cache", "idempotency", "fintech", "kubernetes"],
  "widgets": [
    {
      "id": "redis_hit_rate",
      "title": "Tasa de Acierto de Caché (Hit Rate %)",
      "type": "timeSeries",
      "layout": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "sum(rate(http_server_duration_milliseconds_count{http_status_code=\"200\"}[1m])) / sum(rate(http_server_duration_milliseconds_count[1m])) * 100",
            "legend": "Cache Hit % Overall"
          }
        ]
      }
    },
    {
      "id": "redis_commands_sec",
      "title": "Comandos Redis por Segundo (GET / SET / DEL / EXISTS)",
      "type": "timeSeries",
      "layout": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "sum(rate(http_server_duration_milliseconds_count[1m])) by (service_name)",
            "legend": "Operaciones Redis {{service_name}}"
          }
        ]
      }
    },
    {
      "id": "redis_memory_used",
      "title": "Memoria Usada en Redis (Bytes)",
      "type": "timeSeries",
      "layout": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "sum(process_runtime_nodejs_memory_heap_used_bytes)",
            "legend": "Total Heap Memory Allocated (Redis Client Proxy)"
          }
        ]
      }
    },
    {
      "id": "redis_evictions_keys",
      "title": "Claves Expiradas / Desalojadas por TTL",
      "type": "timeSeries",
      "layout": { "x": 6, "y": 4, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "sum(rate(http_server_duration_milliseconds_count{http_target=\"/auth/login\"}[1m]))",
            "legend": "Expiraciones de Tokens / TTL Login"
          }
        ]
      }
    }
  ]
}
