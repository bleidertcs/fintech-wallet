{
  "schemaVersion": "v6",
  "name": "fintech-05-redis-cache",
  "tags": [
    {
      "key": "tag",
      "value": "redis"
    },
    {
      "key": "tag",
      "value": "cache"
    },
    {
      "key": "tag",
      "value": "idempotency"
    },
    {
      "key": "tag",
      "value": "in-memory"
    },
    {
      "key": "tag",
      "value": "fintech"
    },
    {
      "key": "env",
      "value": "fintech"
    }
  ],
  "spec": {
    "display": {
      "name": "FinTech Wallet - 05. Redis Cache & Idempotency Store",
      "description": "Monitoreo operacional de cach\u00e9 e idempotencia: Comandos por segundo, cambios RDB, CPU, RAM y red."
    },
    "variables": [],
    "panels": {
      "p_redis_commands": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Comandos Redis Procesados por Segundo (Throughput)",
            "description": "Tasa de ejecuci\u00f3n de comandos en el motor Redis en memoria"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "signal": "metrics",
                    "name": "A",
                    "aggregations": [
                      {
                        "metricName": "redis.commands.processed",
                        "timeAggregation": "rate",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "legend": "Comandos / seg"
                  }
                }
              }
            }
          ]
        }
      },
      "p_redis_changes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Cambios RDB desde \u00daltimo Guardado",
            "description": "Operaciones pendientes de persistir en snapshot RDB de Redis"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "signal": "metrics",
                    "name": "A",
                    "aggregations": [
                      {
                        "metricName": "redis.rdb.changes_since_last_save",
                        "timeAggregation": "latest",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "legend": "Cambios RDB"
                  }
                }
              }
            }
          ]
        }
      },
      "p_redis_ram": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memoria RAM Consumida en Pod Redis (Working Set)",
            "description": "Consumo de memoria activa en el contenedor redis-0"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "bytes",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "signal": "metrics",
                    "name": "A",
                    "aggregations": [
                      {
                        "metricName": "k8s.pod.memory.working_set",
                        "timeAggregation": "avg",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "groupBy": [
                      {
                        "name": "k8s.pod.name"
                      }
                    ],
                    "filter": {
                      "expression": "k8s.pod.name LIKE '%redis%'"
                    },
                    "legend": "RAM Usada"
                  }
                }
              }
            }
          ]
        }
      },
      "p_redis_cpu": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Uso de CPU en Pod Redis",
            "description": "Utilizaci\u00f3n del hilo de ejecuci\u00f3n del servidor Redis"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "cores",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "signal": "metrics",
                    "name": "A",
                    "aggregations": [
                      {
                        "metricName": "k8s.pod.cpu.usage",
                        "timeAggregation": "avg",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "groupBy": [
                      {
                        "name": "k8s.pod.name"
                      }
                    ],
                    "filter": {
                      "expression": "k8s.pod.name LIKE '%redis%'"
                    },
                    "legend": "CPU Redis"
                  }
                }
              }
            }
          ]
        }
      },
      "p_redis_network": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Tr\u00e1fico de Red en Pod Redis (Network IO)",
            "description": "Ancho de banda de consultas y respuestas en el pod redis-0"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "bytes",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "signal": "metrics",
                    "name": "A",
                    "aggregations": [
                      {
                        "metricName": "k8s.pod.network.io",
                        "timeAggregation": "rate",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "groupBy": [
                      {
                        "name": "k8s.pod.name"
                      }
                    ],
                    "filter": {
                      "expression": "k8s.pod.name LIKE '%redis%'"
                    },
                    "legend": "Network IO"
                  }
                }
              }
            }
          ]
        }
      },
      "p_redis_restarts": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Reinicios de Contenedor Redis",
            "description": "Monitoreo de estabilidad y reinicios del servidor Redis"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "signal": "metrics",
                    "name": "A",
                    "aggregations": [
                      {
                        "metricName": "k8s.container.restarts",
                        "timeAggregation": "latest",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "groupBy": [
                      {
                        "name": "k8s.pod.name"
                      }
                    ],
                    "filter": {
                      "expression": "k8s.pod.name LIKE '%redis%'"
                    },
                    "legend": "Reinicios"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Main"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p_redis_commands"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p_redis_changes"
              }
            },
            {
              "x": 0,
              "y": 4,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p_redis_ram"
              }
            },
            {
              "x": 6,
              "y": 4,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p_redis_cpu"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p_redis_network"
              }
            },
            {
              "x": 6,
              "y": 8,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p_redis_restarts"
              }
            }
          ]
        }
      }
    ]
  }
}