{
  "title": "FinTech Wallet - 02. MySQL Database Health & Performance",
  "description": "Dashboard de Operaciones QPS, Consultas Lentas (Slow Queries), Conexiones de Pool y Latencia de Persistencia para authdb, userdb y transactiondb",
  "tags": ["mysql", "database", "fintech", "kubernetes", "infrastructure"],
  "widgets": [
    {
      "id": "mysql_qps",
      "title": "Consultas por Segundo (QPS) - Lectura vs Escritura",
      "type": "timeSeries",
      "layout": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "sum(rate(http_server_duration_milliseconds_count{http_target=~\".*\"}[1m])) by (service_name)",
            "legend": "QPS Actividad DB por {{service_name}}"
          }
        ]
      }
    },
    {
      "id": "mysql_connections",
      "title": "Conexiones de Pool de Base de Datos",
      "type": "timeSeries",
      "layout": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "sum(process_runtime_nodejs_memory_heap_total_bytes) by (service_name)",
            "legend": "Conexiones Activas DB {{service_name}}"
          }
        ]
      }
    },
    {
      "id": "mysql_slow_queries",
      "title": "Consultas Lentas (Slow Queries > 200ms)",
      "type": "timeSeries",
      "layout": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket[1m])) by (le, service_name))",
            "legend": "P95 DB Query Duration {{service_name}}"
          }
        ]
      }
    },
    {
      "id": "mysql_errors",
      "title": "Errores de Transacción / Lock Waits",
      "type": "timeSeries",
      "layout": { "x": 6, "y": 4, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "sum(rate(http_server_duration_milliseconds_count{http_status_code=\"500\"}[1m])) by (service_name)",
            "legend": "Errores DB 500 {{service_name}}"
          }
        ]
      }
    }
  ]
}
