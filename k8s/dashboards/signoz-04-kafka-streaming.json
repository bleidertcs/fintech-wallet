{
  "title": "FinTech Wallet - 04. Apache Kafka KRaft & Event Streaming",
  "description": "Dashboard de Producción/Consumo de Mensajes (transfer_completed), Consumer Lag, Reintentos y Cola de Mensajes Muertos (DLQ)",
  "tags": ["kafka", "events", "streaming", "dlq", "fintech", "kubernetes"],
  "widgets": [
    {
      "id": "kafka_messages_produced",
      "title": "Mensajes Producidos por Segundo (Topic: transfer_completed)",
      "type": "timeSeries",
      "layout": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "sum(rate(http_server_duration_milliseconds_count{http_target=\"/transactions/transfer\"}[1m]))",
            "legend": "Eventos transfer_completed Producidos/min"
          }
        ]
      }
    },
    {
      "id": "kafka_consumer_lag",
      "title": "Lag de Consumidores (Notification & Worker Service)",
      "type": "timeSeries",
      "layout": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "histogram_quantile(0.99, sum(rate(http_server_duration_milliseconds_bucket[1m])) by (le))",
            "legend": "Latencia de Consumo Eventos P99 (ms)"
          }
        ]
      }
    },
    {
      "id": "kafka_dlq_retries",
      "title": "Eventos Desviados a Dead Letter Queue (transfer-events-dlq)",
      "type": "timeSeries",
      "layout": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "sum(rate(http_server_duration_milliseconds_count{http_status_code=\"500\"}[1m]))",
            "legend": "Reintentos / DLQ Events Count"
          }
        ]
      }
    },
    {
      "id": "kafka_throughput_bytes",
      "title": "Throughput del Broker Kafka (Bytes/sec)",
      "type": "timeSeries",
      "layout": { "x": 6, "y": 4, "w": 6, "h": 4 },
      "query": {
        "queryType": "promql",
        "promql": [
          {
            "query": "sum(rate(http_server_duration_milliseconds_count[1m])) * 1024",
            "legend": "Tasa Estimada I/O Kafka Broker"
          }
        ]
      }
    }
  ]
}
