# ==========================================
# FinTech Wallet - Git Ignore (Best Practices)
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Build Output
dist/
**/dist/
build/
**/target/
*.tsbuildinfo

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.p12

# IDE & Code Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.iml
*.class
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Docker & Database Local Volumes
mysql-data/
data/

# Logs & Temporary Files
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.claude/
.tmp/
.temp/

# Testing & Coverage
coverage/
.nyc_output/
