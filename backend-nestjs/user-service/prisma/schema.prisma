generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model UserProfile {
  id         BigInt   @id @default(autoincrement())
  name       String
  email      String   @unique
  balance    Decimal  @default(0.00) @db.Decimal(15, 2)
  dailyLimit Decimal  @default(50000.00) @map("daily_limit") @db.Decimal(15, 2)
  currency   String   @default("ARS") @db.VarChar(3)

  @@map("user_profiles")
}
