<clickhouse>
    <listen_host>::</listen_host>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_pool_size>16</background_pool_size>
    <background_fetches_pool_size>8</background_fetches_pool_size>
    <background_common_pool_size>8</background_common_pool_size>
    <max_thread_pool_size>10000</max_thread_pool_size>

    <distributed_ddl>
        <profile>default</profile>
        <!-- Single-node: no esperar confirmación de nodos adicionales -->
        <task_max_lifetime>0</task_max_lifetime>
    </distributed_ddl>

    <macros>
        <shard>01</shard>
        <replica>127.0.0.1</replica>
    </macros>

    <remote_servers>
        <cluster>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port>9000</port>
                </replica>
            </shard>
        </cluster>
    </remote_servers>

    <zookeeper>
        <node index="1">
            <host>127.0.0.1</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>

        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>

        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>127.0.0.1</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>
</clickhouse>
